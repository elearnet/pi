{
	"name": "@earendil-works/pi-coding-agent",
	"version": "0.81.1",
	"description": "Coding agent CLI with read, bash, edit, write tools and session management",
	"type": "module",
	"piConfig": {
		"configDir": ".pi"
	},
	"bin": {
		"pi": "lib/cli.js"
	},
	"main": "./lib-commonjs/index.js",
	"module": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"exports": {
		".": {
			"types": {
				"import": "./lib/index.d.ts",
				"require": "./lib-commonjs/index.d.ts"
			},
			"import": "./lib/index.js",
			"require": "./lib-commonjs/index.js"
		},
		"./rpc-entry": {
			"types": {
				"import": "./lib/rpc-entry.d.ts",
				"require": "./lib-commonjs/rpc-entry.d.ts"
			},
			"import": "./lib/rpc-entry.js",
			"require": "./lib-commonjs/rpc-entry.js"
		}
	},
	"files": [
		"lib",
		"lib-commonjs",
		"docs",
		"examples",
		"containerization.md",
		"CHANGELOG.md",
		"npm-shrinkwrap.json"
	],
	"scripts": {
		"clean": "shx rm -rf lib lib-commonjs",
		"build": "fluentui-scripts build",
		"build-cjs": "node scripts/build-pkg.cjs --cjs",
		"build-esm": "node scripts/build-pkg.cjs --esm",
		"test": "vitest --run",
		"shrinkwrap": "node ../../scripts/generate-coding-agent-shrinkwrap.mjs",
		"prepublishOnly": "yarn run clean && yarn run build && yarn run shrinkwrap"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "workspace:*",
		"@earendil-works/pi-ai": "workspace:*",
		"@earendil-works/pi-tui": "workspace:*",
		"@silvia-odwyer/photon-node": "catalog:pi",
		"chalk": "catalog:current",
		"cross-spawn": "catalog:pi",
		"diff": "catalog:pi",
		"glob": "catalog:pi",
		"highlight.js": "catalog:pi",
		"hosted-git-info": "catalog:pi",
		"ignore": "catalog:pi",
		"jiti": "catalog:pi",
		"minimatch": "catalog:pi",
		"proper-lockfile": "catalog:pi",
		"semver": "catalog:pi",
		"typebox": "catalog:pi",
		"undici": "catalog:pi",
		"yaml": "catalog:pi"
	},
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	},
	"optionalDependencies": {
		"@mariozechner/clipboard": "catalog:pi"
	},
	"devDependencies": {
		"@fluentui-react-native/scripts": "workspace:*",
		"@types/cross-spawn": "catalog:pi",
		"@types/diff": "catalog:pi",
		"@types/hosted-git-info": "catalog:pi",
		"@types/ms": "catalog:pi",
		"@types/node": "catalog:current",
		"@types/proper-lockfile": "catalog:pi",
		"@types/semver": "catalog:current",
		"@typescript/native-preview": "catalog:current",
		"esbuild": "catalog:pi",
		"shx": "catalog:pi",
		"typescript": "catalog:current",
		"vitest": "catalog:current"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/coding-agent"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
