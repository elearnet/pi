{
	"name": "@earendil-works/pi-agent-core",
	"version": "0.81.1",
	"description": "General-purpose agent with transport abstraction, state management, and attachment support",
	"type": "module",
	"main": "./lib-commonjs/index.js",
	"types": "./lib/index.d.ts",
	"exports": {
		".": {
			"types": {
				"import": "./lib/index.d.ts",
				"require": "./lib-commonjs/index.d.ts"
			},
			"import": "./lib/index.js",
			"require": "./lib-commonjs/index.js"
		},
		"./node": {
			"types": {
				"import": "./lib/node.d.ts",
				"require": "./lib-commonjs/node.d.ts"
			},
			"import": "./lib/node.js",
			"require": "./lib-commonjs/node.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"lib-commonjs",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf lib lib-commonjs",
		"build": "fluentui-scripts build",
		"build-cjs": "node scripts/build-pkg.cjs --cjs",
		"build-esm": "node scripts/build-pkg.cjs --esm",
		"test": "vitest --run",
		"test:harness": "vitest --run --config vitest.harness.config.ts",
		"coverage:harness": "vitest --run --config vitest.harness.config.ts --coverage",
		"prepublishOnly": "yarn run build"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "workspace:*",
		"ignore": "catalog:pi",
		"typebox": "catalog:pi",
		"yaml": "catalog:pi"
	},
	"keywords": [
		"ai",
		"agent",
		"llm",
		"transport",
		"state-management"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/agent"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@fluentui-react-native/scripts": "workspace:*",
		"@types/node": "catalog:current",
		"@typescript/native-preview": "catalog:current",
		"@vitest/coverage-v8": "catalog:pi",
		"shx": "catalog:pi",
		"typescript": "catalog:current",
		"vitest": "catalog:current"
	}
}
