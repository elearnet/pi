{
	"name": "@earendil-works/pi-ai",
	"version": "0.81.1",
	"description": "Unified LLM API with automatic model discovery and provider configuration",
	"type": "module",
	"main": "./lib-commonjs/index.js",
	"module": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"sideEffects": [
		"./lib/compat.js",
		"./lib/images.js",
		"./lib/providers/images/register-builtins.js"
	],
	"exports": {
		".": {
			"types": {
				"import": "./lib/index.d.ts",
				"require": "./lib-commonjs/index.d.ts"
			},
			"import": "./lib/index.js",
			"require": "./lib-commonjs/index.js"
		},
		"./compat": {
			"types": {
				"import": "./lib/compat.d.ts",
				"require": "./lib-commonjs/compat.d.ts"
			},
			"import": "./lib/compat.js",
			"require": "./lib-commonjs/compat.js"
		},
		"./providers/*": {
			"types": {
				"import": "./lib/providers/*.d.ts",
				"require": "./lib-commonjs/providers/*.d.ts"
			},
			"import": "./lib/providers/*.js",
			"require": "./lib-commonjs/providers/*.js"
		},
		"./api/*": {
			"types": {
				"import": "./lib/api/*.d.ts",
				"require": "./lib-commonjs/api/*.d.ts"
			},
			"import": "./lib/api/*.js",
			"require": "./lib-commonjs/api/*.js"
		},
		"./oauth": {
			"types": {
				"import": "./lib/oauth.d.ts",
				"require": "./lib-commonjs/oauth.d.ts"
			},
			"import": "./lib/oauth.js",
			"require": "./lib-commonjs/oauth.js"
		},
		"./bedrock-provider": {
			"types": {
				"import": "./lib/bedrock-provider.d.ts",
				"require": "./lib-commonjs/bedrock-provider.d.ts"
			},
			"import": "./lib/bedrock-provider.js",
			"require": "./lib-commonjs/bedrock-provider.js"
		},
		"./bun-oauth": {
			"types": {
				"import": "./lib/bun-oauth.d.ts",
				"require": "./lib-commonjs/bun-oauth.d.ts"
			},
			"import": "./lib/bun-oauth.js",
			"require": "./lib-commonjs/bun-oauth.js"
		}
	},
	"bin": "lib/cli.js",
	"files": [
		"lib",
		"lib-commonjs",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf lib lib-commonjs",
		"generate-models": "node scripts/generate-models.ts --strict",
		"hydrate-model-data": "node scripts/generate-models.ts --strict --data-only",
		"generate-model-catalog": "node scripts/generate-models.ts --strict --json-only --json-output ../../.artifacts/model-catalog",
		"generate-image-models": "node scripts/generate-image-models.ts --strict",
		"check:model-data": "node scripts/check-model-data.ts",
		"build": "fluentui-scripts build",
		"build-cjs": "node scripts/build-pkg.cjs --cjs",
		"build-esm": "node scripts/build-pkg.cjs --esm",
		"test": "vitest --run",
		"prepublishOnly": "yarn run clean && yarn run build"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "catalog:pi",
		"@aws-sdk/client-bedrock-runtime": "catalog:pi",
		"@google/genai": "catalog:pi",
		"@mistralai/mistralai": "catalog:pi",
		"@opentelemetry/api": "catalog:pi",
		"@smithy/node-http-handler": "catalog:pi",
		"http-proxy-agent": "catalog:pi",
		"https-proxy-agent": "catalog:pi",
		"openai": "catalog:pi",
		"partial-json": "catalog:pi",
		"typebox": "catalog:pi"
	},
	"keywords": [
		"ai",
		"llm",
		"openai",
		"anthropic",
		"gemini",
		"bedrock",
		"unified",
		"api"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/ai"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@fluentui-react-native/scripts": "workspace:*",
		"@types/node": "catalog:current",
		"@typescript/native-preview": "catalog:current",
		"canvas": "catalog:pi",
		"esbuild": "catalog:pi",
		"shx": "catalog:pi",
		"vitest": "catalog:current"
	}
}
