{
	"name": "@earendil-works/pi-storage-sqlite-node",
	"version": "0.81.1",
	"description": "Node sqlite storage backend for @earendil-works/pi-agent-core sessions",
	"type": "module",
	"main": "./lib-commonjs/index.js",
	"module": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"exports": {
		".": {
			"types": {
				"import": "./lib/index.d.ts",
				"require": "./lib-commonjs/index.d.ts"
			},
			"import": "./lib/index.js",
			"require": "./lib-commonjs/index.js"
		}
	},
	"files": [
		"lib",
		"lib-commonjs",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf lib lib-commonjs",
		"build": "fluentui-scripts build",
		"build-cjs": "node scripts/build-pkg.cjs --cjs",
		"build-esm": "node scripts/build-pkg.cjs --esm",
		"prepublishOnly": "yarn run clean && yarn run build"
	},
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/storage/sqlite-node"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "workspace:*",
		"@earendil-works/pi-ai": "workspace:*"
	},
	"devDependencies": {
		"@fluentui-react-native/scripts": "workspace:*",
		"@typescript/native-preview": "catalog:current",
		"esbuild": "catalog:pi",
		"shx": "catalog:pi"
	}
}
