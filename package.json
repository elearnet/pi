{
	"name": "pi-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"packages/storage/*",
		"packages/coding-agent/examples/extensions/with-deps",
		"packages/coding-agent/examples/extensions/custom-provider-anthropic",
		"packages/coding-agent/examples/extensions/custom-provider-gitlab-duo",
		"packages/coding-agent/examples/extensions/sandbox",
		"packages/coding-agent/examples/extensions/gondolin"
	],
	"scripts": {
		"clean": "yarn workspaces foreach -A run clean",
		"build": "cd packages/tui && yarn run build && cd ../ai && yarn run build && cd ../agent && yarn run build && cd ../storage/sqlite-node && yarn run build && cd ../../coding-agent && yarn run build && cd ../server && yarn run build",
		"build:offline": "cd packages/tui && yarn run build && cd ../ai && yarn run build:offline && cd ../agent && yarn run build && cd ../storage/sqlite-node && yarn run build && cd ../../coding-agent && yarn run build && cd ../server && yarn run build",
		"check": "biome check --write --error-on-warnings . && yarn run check:pinned-deps && yarn run check:ts-imports && yarn run check:shrinkwrap && yarn run check:install-lock:coding-agent && tsgo --noEmit && yarn run check:browser-smoke",
		"check:browser-smoke": "node scripts/check-browser-smoke.mjs",
		"check:pinned-deps": "node scripts/check-pinned-deps.mjs",
		"check:shrinkwrap": "node scripts/generate-coding-agent-shrinkwrap.mjs --check",
		"check:install-lock:coding-agent": "node scripts/generate-coding-agent-install-lock.mjs --check",
		"check:ts-imports": "node scripts/check-ts-relative-imports.mjs",
		"generate:models": "yarn --cwd packages/ai run generate-models && yarn --cwd packages/ai run generate-image-models",
		"hydrate:model-data": "yarn --cwd packages/ai run hydrate-model-data",
		"check:model-data": "yarn --cwd packages/ai run check:model-data",
		"generate:model-catalog": "yarn --cwd packages/ai run generate-model-catalog",
		"diff:model-catalog": "node scripts/diff-model-catalog.mjs",
		"check:model-catalog": "node scripts/publish-model-catalog.mjs --input .artifacts/model-catalog --dry-run",
		"profile:tui": "node scripts/profile-coding-agent-node.mjs --mode tui",
		"profile:rpc": "node scripts/profile-coding-agent-node.mjs --mode rpc",
		"test": "yarn workspaces foreach -A run test",
		"version:patch": "yarn version patch --all && node scripts/sync-versions.js",
		"version:minor": "yarn version minor --all && node scripts/sync-versions.js",
		"version:major": "yarn version major --all && node scripts/sync-versions.js",
		"version:set": "yarn version --all",
		"prepublishOnly": "yarn run clean && yarn run build && yarn run check",
		"publish": "yarn run prepublishOnly && node scripts/publish.mjs",
		"publish:dry": "yarn run prepublishOnly && node scripts/publish.mjs --dry-run",
		"release:local": "node scripts/local-release.mjs",
		"shrinkwrap:coding-agent": "node scripts/generate-coding-agent-shrinkwrap.mjs",
		"install-lock:coding-agent": "node scripts/generate-coding-agent-install-lock.mjs",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"release:fix-links": "node scripts/release-notes.mjs fix-github-releases",
		"prepare": "husky"
	},
	"devDependencies": {
		"@anthropic-ai/sandbox-runtime": "catalog:pi",
		"@biomejs/biome": "catalog:current",
		"@types/node": "catalog:current",
		"@typescript/native-preview": "catalog:current",
		"esbuild": "catalog:pi",
		"husky": "catalog:current",
		"jiti": "catalog:pi",
		"shx": "catalog:pi",
		"tsx": "catalog:pi",
		"typescript": "catalog:current"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.0.3",
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	}
}
